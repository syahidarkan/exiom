# Exiom Virtual Office Agent — Environment Variables
# Salin file ini ke .env dan isi dengan nilai yang sebenarnya
# JANGAN commit .env ke git
#
# ================================================================
# ANTHROPIC CLAUDE API KEYS
# Dapatkan dari: console.anthropic.com → Workspace "Agent Bisnis"
# Buat 4 API key terpisah sesuai pengelompokan di handbook
# ================================================================

# GROUP 1 — Kenzie (IT Manager) + Adi (Developer)
EXIOM_CLAUDE_KEY_G1=sk-ant-api03-XXXXXXXX

# GROUP 2 — Mia (Marketing Manager) + Deril (Editor) + Gagah (SEO Researcher)
EXIOM_CLAUDE_KEY_G2=sk-ant-api03-XXXXXXXX

# GROUP 3 — Nela (PR Manager) + Ale (Client Relations) + Joce (Client Acquisition)
EXIOM_CLAUDE_KEY_G3=sk-ant-api03-XXXXXXXX

# GROUP 4 — Hugo (Finance)
EXIOM_CLAUDE_KEY_G4=sk-ant-api03-XXXXXXXX

# ================================================================
# DATABASE
# ================================================================
EXIOM_DB_HOST=127.0.0.1
EXIOM_DB_PORT=5432
EXIOM_DB_NAME=exiom_office
EXIOM_DB_USER=exiom
EXIOM_DB_PASSWORD=exiom_local_db_2026

# ================================================================
# TELEGRAM — notifikasi approval queue ke Owner
# Bot token & user ID sudah ada di Hermes default profile
# ================================================================
EXIOM_TELEGRAM_BOT_TOKEN=XXXXXXXXXX:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EXIOM_TELEGRAM_OWNER_CHAT_ID=YOUR_TELEGRAM_USER_ID

# ================================================================
# WHATSAPP BUSINESS API (port 3000, untuk Exiom CS — Ale)
# Dipakai Ale untuk handle inbound WA dari calon klien
# ================================================================
EXIOM_WA_API_URL=http://127.0.0.1:3000
EXIOM_WA_SESSION=default
# EXIOM_WA_CS_PHONE diisi saat setup Ale di Fase 4

# ================================================================
# HERMES BUSINESS LITELLM PROXY (port 4001)
# ================================================================
EXIOM_LITELLM_PROXY_URL=http://127.0.0.1:4001/v1
EXIOM_LITELLM_MASTER_KEY=sk-exiom-business-proxy

# ================================================================
# SOSMED API KEYS (diisi nanti per fase)
# ================================================================
# Instagram/Facebook Graph API
# META_ACCESS_TOKEN=
# META_PAGE_ID=

# TikTok Content Posting API
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# YouTube Data API (Google Cloud)
# YOUTUBE_API_KEY=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# X (Twitter) API
# X_BEARER_TOKEN=
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# Threads API (via Meta Business)
# THREADS_ACCESS_TOKEN=

# ================================================================
# OUTBOUND CONTACT (Fase 4)
# ================================================================
# Resend (email outbound proposal Joce)
# RESEND_API_KEY=

# GitHub + Vercel (Fase 3 dev pipeline)
# GITHUB_TOKEN=
# VERCEL_TOKEN=
